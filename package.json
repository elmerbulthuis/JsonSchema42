{
  "private": true,
  "packageManager": "npm@10.8.1",
  "workspaces": [
    "packages/npm/*"
  ],
  "scripts": {
    "tsc": "tsc --build",
    "tsc-watch": "npm run tsc -- --watch",
    "test": "node --test packages/npm/*/transpiled/**/*.test.js packages/npm/*/src/**/*.test.js",
    "spelling": "cspell",
    "formatting": "prettier --check --ignore-unknown *",
    "fix-formatting": "prettier --write --ignore-unknown *"
  },
  "devDependencies": {
    "@go-task/cli": "^3.48.0",
    "c8": "^10.1.3",
    "cspell": "^9.6.4",
    "prettier": "^3.8.1"
  }
}
