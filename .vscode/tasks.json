{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cargo",
      "command": "build",
      "problemMatcher": ["$rustc"],
      "group": "build",
      "label": "cargo build"
    },
    {
      "type": "npm",
      "script": "tsc",
      "label": "tsc",
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "type": "npm",
      "script": "tsc-watch",
      "isBackground": true,
      "label": "tsc-watch",
      "group": "build",
      "problemMatcher": ["$tsc-watch"]
    },
    {
      "type": "cargo",
      "command": "test",
      "problemMatcher": ["$rustc"],
      "group": "test",
      "label": "cargo test",
      "env": {
        "RUSTFLAGS": "--codegen instrument-coverage=all",
        "LLVM_PROFILE_FILE": "${workspaceFolder}/coverage/default_%m_%p.profraw"
      }
    }
  ]
}
