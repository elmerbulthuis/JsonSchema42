{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "typescript file",
      "program": "${file}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/packages/npm/*/transpiled/**/*.js"],
      "preLaunchTask": "tsc-watch",
      "outputCapture": "std"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "jns42-generator npm",
      "runtimeExecutable": "npx",
      "program": "jns42-generator",
      "args": [
        "package",
        "${file}",
        "--package-directory",
        ".generated/file/npm/${fileBasenameNoExtension}",
        "--package-name",
        "${fileBasenameNoExtension}",
        "--package-version",
        "0.0.0"
      ],
      "env": {
        "NODE_ENV": "development"
      },
      "cwd": "${workspaceFolder}",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/packages/npm/*/transpiled/**/*.js"],
      "preLaunchTask": "tsc-watch",
      "outputCapture": "std"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "jns42-generator cargo",
      "cargo": {
        "args": ["build", "--bin", "jns42-generator", "--package", "jns42-generator"]
      },
      "args": [
        "package",
        "${file}",
        "--package-directory",
        ".generated/file/cargo/${fileBasenameNoExtension}",
        "--package-name",
        "${fileBasenameNoExtension}",
        "--package-version",
        "0.0.0"
      ],
      "cwd": "${workspaceFolder}"
    }
  ]
}
